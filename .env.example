# Local development example only. Never use these defaults in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=saffron
POSTGRES_USER=saffron
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://saffron:local_dev_only_change_me@127.0.0.1:5433/saffron

DUNE_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434

# Optional GitHub integration. Configure only when ready to test it.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=
SAFFRON_ENABLE_REAL_GITHUB_READS=false
